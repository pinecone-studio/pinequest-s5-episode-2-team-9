rules_version = '2';

// Each user can read and write only their own documents. The admin can read everything.
// Subscriptions and payments are written only by the server (Firebase Admin SDK skips these rules).
// Publish in the Firebase console: Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Keep in sync with ADMIN_EMAIL in src/billing/pricing.ts. A verified email is required,
    // so nobody can claim the address with an unverified email/password account.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'brkh1222@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'lang', 'createdAt', 'lastSeenAt']);

      match /progress/{modelId} {
        allow read: if isOwner(uid) || isAdmin();
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && modelId.size() <= 40
          && request.resource.data.keys().hasOnly(['studied', 'assemblies', 'bestAssemblyMs', 'lastOpenedAt', 'updatedAt'])
          && (!('studied' in request.resource.data) || (request.resource.data.studied is list && request.resource.data.studied.size() <= 200))
          && (!('assemblies' in request.resource.data) || request.resource.data.assemblies is int)
          && (!('bestAssemblyMs' in request.resource.data) || request.resource.data.bestAssemblyMs is number);
      }
    }

    // The models a user chose to open for free (src/billing/access.ts). The list can only grow,
    // to at most 2, and can't be deleted, so a pick can't be undone or swapped.
    match /freePicks/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['models', 'updatedAt'])
        && request.resource.data.models is list
        && request.resource.data.models.size() <= 2
        && (resource == null || request.resource.data.models.hasAll(resource.data.models));
    }

    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
    }

    match /payments/{invoiceId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
  }
}
