# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# Copy to .env.local and fill in. These values ship in the browser bundle; they are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server only (Vercel env vars). The fine-tuned Gemma tutor behind /api/ask: a Hugging Face Inference
# Endpoint URL (OpenAI-compatible) and an HF token that can call it. See training/README.md.
TUTOR_ENDPOINT_URL=
TUTOR_ENDPOINT_TOKEN=
# Only for the Ollama backup: the local model name.
TUTOR_ENDPOINT_MODEL=
# Server only. Until the fine-tuned endpoint is set, /api/ask answers with Gemini Flash on Google's
# free tier: create a key at https://aistudio.google.com/apikey (no billing needed). Free-tier
# requests may be used by Google to improve its products. GEMINI_MODEL overrides the model name.
GEMINI_API_KEY=
GEMINI_MODEL=
# Local only: scripts/build-tutor-dataset.ts and scripts/judge-tutor-eval.ts use Claude.
ANTHROPIC_API_KEY=
